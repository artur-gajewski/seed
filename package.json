{
  "name": "seed-lm-studio",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "native:build": "node scripts/build-native.ts",
    "benchmark": "node scripts/benchmark-training.ts",
    "evaluate": "node scripts/evaluate-color-reasoning.ts",
    "analyze:compositional": "node scripts/analyze-compositional-generalization.ts",
    "reference:compositional": "node scripts/create-compositional-generalization-reference.ts",
    "train": "node scripts/train-model.ts",
    "profile:training": "node scripts/profile-training.ts",
    "dev": "node server/dev.ts",
    "server": "node server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "node server/index.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "vite": "7.1.7",
    "typescript": "5.8.3",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/node": "24.19.0",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": "24.x"
  }
}
